#!/bin/sh
# Debian post-installation for zhiyi-ime.
set -e

if [ "$1" = "configure" ]; then
    if command -v gtk-update-icon-cache >/dev/null 2>&1 && \
       [ -d /usr/share/icons/hicolor ]; then
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
    fi

    cat <<'EOF'

知意输入法 (fcitx4) 已安装。

使输入法生效（当前用户，无需 root）：
    fcitx -r                    # 重启正在运行的 fcitx
  或者注销并重新登录。

然后用 Ctrl+Space 打开输入法、Ctrl+Shift 切换到「知意输入法」。
若当前默认框架不是 fcitx：
    im-config -n fcitx && 注销重新登录

配置（候选数、模糊音、双拼、候选横排竖排、中文标点、中英默认状态）：
    zhiyi-config --show
    zhiyi-config --set fuzzy 1
    zhiyi-config --set layout horizontal    # 候选横排显示，vertical 竖排
配置文件： ~/.config/zhiyi/config.json （由 zhiyi-config 自动同步）

皮肤（5 套，移植自青简输入法，已装到 /usr/share/fcitx/skin/zhiyi-qingjian*，
与青简官方 qingjian-fcitx4 包的皮肤并存不冲突）：
    fcitx-config-gtk3          # 外观 -> 皮肤 里选择 知意青简绿 等
  或者直接写入 ~/.config/fcitx/config：
    [Appearance]
    SkinName=zhiyi-qingjian
  改完执行 fcitx -r 生效；皮肤对 fcitx 全局生效（经典候选窗只有一套皮肤）。

托盘设置（推荐）：登录后自动运行 zhiyi-tray，切到知意输入法时托盘出现
「知」图标，菜单可直接改候选数、横竖排、双拼、模糊音、皮肤等，全部立即生效：
    zhiyi-tray --check         # 无界面检查当前状态
    zhiyi-tray --setup         # 可选：禁用 fcitx 自带托盘与搜狗 dbusmenu 插件
    zhiyi-tray --undo-setup    # 恢复

数据目录： /usr/share/zhiyi/data，用户词库： ~/.local/share/zhiyi/user.tsv
EOF
fi

exit 0
